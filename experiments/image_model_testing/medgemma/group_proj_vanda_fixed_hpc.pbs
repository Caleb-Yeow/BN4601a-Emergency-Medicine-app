#!/bin/bash
#PBS -N medgemma_group
# auto_free routes to an execution queue; replace it if your account has
# a different authorized GPU queue.
#PBS -q auto_free
# One GPU, conservative CPU use, and enough host RAM for checkpoint/export work.
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

SCRATCH_ROOT="/scratch/<NUS-ID>"
VANDA_VENV="/scratch/<NUS-ID>/venvs/group_proj"
RUN_ROOT="$SCRATCH_ROOT/medgemma_examine"
LOG_ROOT="$RUN_ROOT/pbs_logs"

mkdir -p "$RUN_ROOT" "$LOG_ROOT"
exec > >(tee "$LOG_ROOT/job-$PBS_JOBID.log") 2>&1

# Load modules before activating the virtual environment.
module load python39
module load cuda12.4/toolkit/12.4.1

if [ ! -x "$VANDA_VENV/bin/python" ]; then
    echo "Missing virtual environment: $VANDA_VENV" >&2
    exit 2
fi

source "$VANDA_VENV/bin/activate"

export PYTHONUNBUFFERED=1
export VANDA_SCRATCH="$SCRATCH_ROOT"
export HF_HOME=/scratch/<NUS-ID>/group_proj_cache_fast/hf_cache
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_HUB_OFFLINE=1
export MEDGEMMA_USE_FAST_PROCESSOR=1
export GROUP_PROJ_MAX_SAMPLES=500
export GROUP_PROJ_EPOCHS=1
export GROUP_PROJ_RUN_TEST=1
export GROUP_PROJ_SAVE_FULL_PTH=0
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

mkdir -p "$HF_HOME" "$HF_HUB_CACHE"

echo "Host: $(hostname)"
echo "PBS job: $PBS_JOBID"
echo "Python: $(command -v python)"
echo "Working directory: $(pwd)"
echo "Run root: $RUN_ROOT"
echo "HF cache: $HF_HOME"

nvidia-smi

python - <<'PY'
import sys
import torch

print("Python executable:", sys.executable)
print("PyTorch:", torch.__version__)
print("PyTorch CUDA build:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())
print("CUDA device count:", torch.cuda.device_count())

if not torch.cuda.is_available():
    raise SystemExit("CUDA is unavailable in the PBS GPU allocation.")

print("GPU:", torch.cuda.get_device_name(0))
print("Compute capability:", torch.cuda.get_device_capability(0))
print(
    "GPU memory GB:",
    round(torch.cuda.get_device_properties(0).total_memory / 1024**3, 2),
)
PY

python - <<'PY'
from huggingface_hub import snapshot_download

checks = [
    ("MedGemma", "google/medgemma-4b-it", None),
    ("MultiCaRe images", "OpenMed/multicare-images", "dataset"),
    ("MultiCaRe cases", "OpenMed/multicare-cases", "dataset"),
]

for label, repo, repo_type in checks:
    kwargs = {"repo_id": repo, "local_files_only": True}
    if repo_type:
        kwargs["repo_type"] = repo_type
    path = snapshot_download(**kwargs)
    print(f"{label} offline cache: {path}")
PY

if [ ! -f group_proj_vanda___fixed.py ]; then
    echo "group_proj_vanda___fixed.py is missing from $PBS_O_WORKDIR" >&2
    exit 3
fi

python -u group_proj_vanda___fixed.py
