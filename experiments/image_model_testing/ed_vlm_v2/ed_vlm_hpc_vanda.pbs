#!/bin/bash
#PBS -N ed_vlm
# Change auto_free to the GPU queue authorized for your account.
#PBS -q auto_free
#PBS -l select=1:ngpus=1:ncpus=18:mem=120gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

WORK_ROOT="${ED_VLM_WORKDIR:-}"
if [ -z "$WORK_ROOT" ]; then WORK_ROOT=/scratch/<NUS-ID>/ed_vlm; fi
VANDA_VENV="${VANDA_VENV:-}"
if [ -z "$VANDA_VENV" ]; then VANDA_VENV=/scratch/<NUS-ID>/venvs/edvlm; fi
LOG_ROOT="$WORK_ROOT/pbs_logs"
mkdir -p "$WORK_ROOT" "$LOG_ROOT"
exec > >(tee "$LOG_ROOT/job-$PBS_JOBID.log") 2>&1

if [ ! -x "$VANDA_VENV/bin/python" ]; then
    echo "Missing virtual environment: $VANDA_VENV" >&2
    exit 2
fi

# Load the base modules before activating the virtual environment. Loading
# Python after activation can overwrite PATH and silently use system Python.
module load python39
module load cuda12.4/toolkit/12.4.1
source "$VANDA_VENV/bin/activate"
export PYTHONUNBUFFERED=1
export ED_VLM_SKIP_INSTALL=1
export ED_VLM_WORKDIR="$WORK_ROOT"
export HF_HOME="$WORK_ROOT/hf_cache"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=18
export MKL_NUM_THREADS=18
mkdir -p "$HF_HOME" "$HF_HUB_CACHE"

echo "Host: $(hostname)"
echo "PBS job: $PBS_JOBID"
echo "Python: $(command -v python)"
nvidia-smi

python - <<'PY'
import torch
print("PyTorch:", torch.__version__)
print("CUDA:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())
print("GPU count:", torch.cuda.device_count())
if not torch.cuda.is_available():
    raise SystemExit("CUDA is unavailable.")
print("GPU:", torch.cuda.get_device_name(0))
PY

# Quick end-to-end check first (~15-20 min):  qsub -v ED_VLM_SMOKE=1 ed_vlm_hpc_vanda.pbs
if [ "${ED_VLM_SMOKE:-0}" = "1" ]; then
    python -u ed_vlm_pipeline.py --profile hpc --smoke --run-name smoke_v2 --resume -1
    exit 0
fi

# Full run. --resume latest: if the job hits the walltime, qsub the same script again to continue.
# Expected: ~1 s per training example on an A40 -> 4000 images x <=5 epochs ~ 6 h, plus ~1-2 h of testing.
# Time left, from the login node:  python3 progress.py --watch 60
RUN_NAME="${ED_VLM_RUN_NAME:-}"
if [ -z "$RUN_NAME" ]; then RUN_NAME=hpc_v2_4000; fi
python -u ed_vlm_pipeline.py \
  --profile hpc \
  --run-name "$RUN_NAME" \
  --resume latest \
  --set use_fast=True \
  --set max_images=4000 \
  --set max_val_images=300 \
  --set max_test_images=600 \
  --set max_per_case=2 \
  --set max_per_article=4 \
  --set assess_steps=False \
  --set eval_no_note=True \
  --set epochs=5 \
  --set val_every_steps=40 \
  --set save_every_steps=20 \
  --set max_val_examples=300 \
  --set max_test_examples=400 \
  --set n_eval_gen=250 \
  --set train_minutes=1080 \
  --set eval_minutes=150 \
  --set merged_export=False